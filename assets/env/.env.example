# Copy this file to assets/env/.env (or .env.development / .env.production per flavor)
# and fill in values (Supabase Dashboard → Settings → API).
# Or use: flutter run --dart-define=SUPABASE_URL=... --dart-define=SUPABASE_ANON_KEY=...
#
# Google login is configured in Supabase (Authentication → Providers → Google).
# Add redirect URL for mobile: havamind://login-callback (see Supabase URL Configuration).
#
SUPABASE_URL=https://dfdfddf.supabase.co
SUPABASE_ANON_KEY=dfdfddf
OPENAI_API_KEY=sk-your-openai-api-key
REVENUECAT_API_KEY=your-revenuecat-api-key
# Optional: shown on Profile → Legal when set (use production URLs for store builds).
PRIVACY_POLICY_URL=
TERMS_OF_SERVICE_URL=
