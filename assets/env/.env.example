# TEMPLATE ONLY — the app does not load this file.
# Copy to assets/env/.env.development and/or .env.production (gitignored)
# and fill in values (Supabase Dashboard → Settings → API).
# Or use: flutter run --dart-define=SUPABASE_URL=... --dart-define=SUPABASE_ANON_KEY=...
#
# Google login is configured in Supabase (Authentication → Providers → Google).
#
# Supabase → Authentication → URL Configuration:
#   Redirect URLs: havamind://login-callback
#   Site URL: your production web URL (NOT http://localhost:3000 for store builds)
#
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# RevenueCat public SDK keys.
# Development flavor: use the Test Store key (test_…) so local purchases work.
# Store builds MUST use appl_… (iOS) / goog_… (Android), never test_.
# A single legacy REVENUECAT_API_KEY is still read as a fallback.
REVENUECAT_API_KEY_IOS=appl_your_ios_key
REVENUECAT_API_KEY_ANDROID=goog_your_android_key
# NOTE: OPENAI_API_KEY is NOT a client secret. It is used only by the
# process-audio-note Edge Function and must be set server-side, never bundled:
#   supabase secrets set OPENAI_API_KEY=sk-...
# Optional: shown on Profile → Legal when set (use production URLs for store builds).
PRIVACY_POLICY_URL=
TERMS_OF_SERVICE_URL=
