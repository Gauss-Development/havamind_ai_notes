<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Store distribution export. Used by:
	     flutter build ipa --flavor production -t lib/main_production.dart \
	       --export-options-plist=ios/ExportOptions.plist
	     If Xcode reports an invalid method, change "app-store-connect" to "app-store". -->
	<key>method</key>
	<string>app-store-connect</string>

	<!-- Verify this is the team that owns the app in App Store Connect.
	     XGUA3UZ6UK = team of your "Apple Development" iOS certificate.
	     (You also have team 75K8CS869U — the macOS "Developer ID" one.) -->
	<key>teamID</key>
	<string>XGUA3UZ6UK</string>

	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
	<key>stripSwiftSymbols</key>
	<true/>
	<key>destination</key>
	<string>export</string>
</dict>
</plist>
